# Cedar Eye Clinic. Works at a domain root or in a sub-folder: no paths below are absolute.

DirectoryIndex index.php
Options -Indexes -MultiViews
AddDefaultCharset utf-8
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve the app's internals, setup files or tooling.
  RewriteRule ^(includes|admin/partials|_legacy|\.taste-skill|shots|node_modules|tools)(/|$) 404.php [L]
  RewriteRule (^|/)\. 404.php [L]
  RewriteRule \.(sql|lock|md|log|ini|sh|bak|dist|json|lock|mjs|example\.php)$ 404.php [NC,L]
  RewriteRule ^(composer|package|tailwind\.config)(-lock)?\.(json|js)$ 404.php [NC,L]

  # sitemap.xml is built from the database
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # Anything that is not a real file or folder is a 404 page (with a 404 status).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
  <FilesMatch "\.(sql|lock|md|log|ini|sh|bak)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Photograph credits list is read by PHP only
<Files "credits.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # Static files: fonts and versioned css/js never change at the same address
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2|css|js|jpe?g|png|webp|ico|svg)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
